# App
NEXT_PUBLIC_TWITTER_HANDLE=@agrocyms
# Optional social profile URLs. Defaults use the Twitter/X handle.
# NEXT_PUBLIC_X_URL=https://x.com/agrocyms
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/agrocyms
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/agrocyms
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/agrocyms
NEXT_PUBLIC_SITE_URL=https://agrocyms.com
NEXT_PUBLIC_SITE_LOCALE=en
# Optional contact inbox used by the public contact form
# NEXT_PUBLIC_CONTACT_EMAIL=contact@agrocyms.com

# Optional Search Console / Bing verification tokens
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Frontend dev server
PORT=8080

# Browser API base. Use /api so HTTP-only cookies stay same-site.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin that /api is proxied to (no trailing slash or /api)
API_PROXY_TARGET=http://localhost:5050

# Used when the app runs in Docker and the API is on the host machine
DOCKER_API_PROXY_TARGET=http://host.docker.internal:5050

# Client request timeout in milliseconds
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=30000
