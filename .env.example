# App
NEXT_PUBLIC_APP_NAME=Agrocyms
NEXT_PUBLIC_APP_TAGLINE=Farm management
NEXT_PUBLIC_APP_TITLE=Agrocyms - Multi-Enterprise Farm Management
NEXT_PUBLIC_APP_DESCRIPTION=Agrocyms multi-enterprise farm management for poultry, small ruminants, and herd operations — inventory, production, and health tracking
NEXT_PUBLIC_LOGO_PATH=/Agrocyms%20logo.png
NEXT_PUBLIC_TWITTER_HANDLE=@agrocyms
NEXT_PUBLIC_SITE_URL=https://agrocyms.com
NEXT_PUBLIC_SITE_LOCALE=en
# Optional Search Console / Bing verification tokens
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Frontend dev server
PORT=8080

# Browser API base. Use /api so HTTP-only cookies stay same-site.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin that /api is proxied to (no trailing slash or /api)
API_PROXY_TARGET=http://localhost:5050

# Client request timeout in milliseconds
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=30000
